<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="__co_testPU" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for an In-Memory DB</description>
    <!--    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>-->
    <!--        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <!-- OrderItemWithEmbeddedId and OrderItemWithIdClass map ORDER_ITEMS, two ways; only one may be listed. With
         both, EclipseLink stops reporting a single id attribute for the @EmbeddedId flavour, and its metamodel then
         throws from getIdClassAttributes(). -->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Customer</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Inventory</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Order</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemWithEmbeddedId</class>
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemWithIdClass</class>-->
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemId</class>-->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Product</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Shipment</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Shipment$ShipmentStatusConverter</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Store</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.CustomerOrderProduct</class>
    <!-- ProductOrderWithEmbeddedId and ProductOrderWithIdClass map PRODUCT_ORDERS, two ways; only one may be listed.
         With both, EclipseLink stops reporting a single id attribute for the @EmbeddedId flavour, and its
         metamodel then throws from getIdClassAttributes(). -->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderId</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderWithEmbeddedId</class>
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderWithIdClass</class>-->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- ///////////////////////////////////////////////// https://github.com/eclipse-ee4j/eclipselink/issues/1393 -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:;database_to_upper=false;MODE=LEGACY"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- ///////////////////////////////////////////////////////////////////////////////////////////// eclipselink -->
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/Logging -->
      <!--      <property name="eclipselink.logging.level" value="FINE"/>-->
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      <!--      <property name="eclipselink.weaving" value="true"/>-->
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/DDL -->
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
      <property name="eclipselink.ddl-generation" value="create-tables"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="__co_itPU" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for a Physical Database</description>
    <!--    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>-->
    <!--    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <mapping-file>META-INF/orm-it.xml</mapping-file>
    <!-- OrderItemWithEmbeddedId and OrderItemWithIdClass map ORDER_ITEMS, two ways; only one may be listed. With
         both, EclipseLink stops reporting a single id attribute for the @EmbeddedId flavour, and its metamodel then
         throws from getIdClassAttributes(). -->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Customer</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Inventory</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Order</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemWithEmbeddedId</class>
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemWithIdClass</class>-->
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.OrderItemId</class>-->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Product</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Shipment</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Shipment$ShipmentStatusConverter</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.Store</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.StoreLogo</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.CustomerOrderProduct</class>
    <!-- ProductOrderWithEmbeddedId and ProductOrderWithIdClass map PRODUCT_ORDERS, two ways; only one may be listed.
         With both, EclipseLink stops reporting a single id attribute for the @EmbeddedId flavour, and its
         metamodel then throws from getIdClassAttributes(). -->
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderId</class>
    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderWithEmbeddedId</class>
    <!--    <class>com.github.jinahya.oracle.sample.schemas.persistence.co.ProductOrderWithIdClass</class>-->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="oracle.jdbc.driver.OracleDriver"/>
      <!-- https://github.com/eclipse-ee4j/eclipselink/issues/1393 -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:oracle:thin:@//localhost:1521/freepdb1"/>
      <!--      <property name="jakarta.persistence.jdbc.user" value="co"/>-->
      <property name="jakarta.persistence.jdbc.user" value="dmlonly"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- ///////////////////////////////////////////////////////////////////////////////////////////// eclipselink -->
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/Logging -->
      <!--      <property name="eclipselink.logging.level" value="FINE"/>-->
      <property name="eclipselink.ddl-generation" value="none"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      <!--      <property name="eclipselink.weaving" value="true"/>-->
      <!-- https://wiki.eclipse.org/EclipseLink/Examples/JPA/DDL -->
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.OraclePlatform"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.OracleDialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
